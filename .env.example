# ==============================================================================
# Touch And Go (TAG) - Environment Variable Template
# ==============================================================================
# IMPORTANT SECURITY NOTICE:
# - NEVER commit sensitive credentials, secret keys, or private tokens to Git.
# - Only prefix variables with NEXT_PUBLIC_ if they are explicitly safe to expose
#   in client-side browser bundles.
# - Copy this file to .env.local for local overrides.
# ==============================================================================

# Application Environment & Base URLs
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Client Performance & Mock Controls
# Set to 'true' only if simulating artificial network latency for UI skeletons
NEXT_PUBLIC_ENABLE_MOCK_DELAY=false

# Analytics & Public Keys (Safe for Client Bundles)
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Private Server-Side Secrets (DO NOT prefix with NEXT_PUBLIC_)
# JWT_SECRET=
# DATABASE_URL=
# API_SECRET_KEY=
